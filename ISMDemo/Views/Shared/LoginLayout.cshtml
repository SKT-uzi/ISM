@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using ISMDemo.Utilities;
@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCultureName = Html.Raw(JsonConvert.SerializeObject(requestCulture.RequestCulture.Culture.Name.ToLower()));
}
<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="format-detection" content="telephone=no">
    <meta name="theme-color" content="#ffffff">
    <title>@LocalizerHelper.LocalizerResource["Common_AppName"] | @LocalizerHelper.LocalizerResource["Common_SystemName"]</title>
    <link rel="icon" type="image/png" href="~/images/favicon.png" asp-append-version="true">
    <link rel="stylesheet" href="~/css/common.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout-ism.css" asp-append-version="true" />
</head>
<body class="enter-password">
    <input type="hidden" id="hidISMVPath" value="@Configuration.ISMVirtualPath" />
    <script type="text/javascript" src="~/js/resources.js"></script>
     @RenderBody()
    <script type="text/javascript" src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/lib/jquery.blockUI.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/lib/moment/moment.min.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/lib/mqtt.min.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/propertyExtend.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/maskHelper.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/modal.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/controller.js" asp-append-version="true"></script>    
    <script type="text/javascript" src="~/js/app.js" asp-append-version="true"></script>    
    @RenderSection("Styles", required: false)
    @if (requestCulture.RequestCulture.Culture.Name.ToLower() == "es-mx")
    {
        @await RenderSectionAsync("ESScripts", required: false)
        <script type="text/javascript" src="~/lib/moment//locale/es.js" asp-append-version="true"></script>
        <script type="text/javascript" src="~/lib/moment//locale/es-mx.js" asp-append-version="true"></script>
        <script>
            moment.locale("es-mx");
        </script>
    }
    else
    {
        IgnoreSection("ESScripts");
    }

    @{
        var localizedResources = LocalizerHelper.LocalizerResource.GetAllStrings(false);
        var localizedStrings = Html.Raw(JsonConvert.SerializeObject(localizedResources));
    }

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        resources.requestCultureName = @currentCultureName;
        resources.localizedStrings = @localizedStrings;
    </script>
</body>
</html>
