@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using ISMDemo.Utilities
@using System.Security.Claims
@using Microsoft.AspNetCore.Http

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCultureName = Html.Raw(JsonConvert.SerializeObject(requestCulture.RequestCulture.Culture.Name.ToLower()));
    var configMode = Context.Session.GetString(Const.SESSION_CONFIG_MODE_NAME);
    var serverConfigConsts = JsonConvert.SerializeObject(new ServerConfigConsts());
}
<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="format-detection" content="telephone=no">
    <meta name="theme-color" content="#ffffff">
    <title>@LocalizerHelper.LocalizerResource["Common_AppName"] | @LocalizerHelper.LocalizerResource["Common_SystemName"]</title>
    <link rel="icon" type="image/png" href="~/images/favicon.png" asp-append-version="true">
    <link rel="stylesheet" href="~/css/simple-keyboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/common.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout-ism.css" asp-append-version="true" />
</head>
<body>
    <input type="hidden" id="hidISMVPath" value="@Configuration.ISMVirtualPath" />
    <script type="text/javascript" src="~/js/resources.js"></script>
    @await Html.PartialAsync("Header.cshtml", new ViewDataDictionary(ViewData) { { "HeaderType", configMode } })
    @RenderBody()
    <script type="text/javascript" src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/lib/jquery-validation/dist/jquery.validate.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/lib/jquery-validation/dist/additional-methods.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/lib/jquery.blockUI.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/lib/moment/moment.min.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/lib/mqtt.min.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/lib/md5.min.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/lib/simple-keyboard.min.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/propertyExtend.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/validationExtend.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/maskHelper.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/modal.js" asp-append-version="true"></script>    
    <script type="text/javascript" src="~/js/controller.js" asp-append-version="true"></script>    
    <script type="text/javascript" src="~/js/app.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/auth.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/mqttClient.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/app-keyboard.js" asp-append-version="true"></script>
    @RenderSection("Styles", required: false)
    
    @if (requestCulture.RequestCulture.Culture.Name.ToLower() == "es-mx")
    {
        @await RenderSectionAsync("ESScripts", required: false)
        <script type="text/javascript" src="~/lib/jquery-validation/dist/localization/messages_es.min.js" asp-append-version="true"></script>
        <script type="text/javascript" src="~/lib/moment//locale/es.js" asp-append-version="true"></script>
        <script type="text/javascript" src="~/lib/moment//locale/es-mx.js" asp-append-version="true"></script>
        <script>
            moment.locale("es-mx");
        </script>
    }
    else
    {
        IgnoreSection("ESScripts");
    }

    @{
        var localizedResources = LocalizerHelper.LocalizerResource.GetAllStrings(false);
        var localizedStrings = Html.Raw(JsonConvert.SerializeObject(localizedResources));
    }

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        resources.requestCultureName = @currentCultureName;
        resources.localizedStrings = @localizedStrings;
    </script>

    <section class="modal modal-message modal-message-warn" data-bind="animationIn:fadeInDown10,animationOut:fadeOutUp10">
	    <div class="modal-dialog">
		    <div class="modal-content">
			    <div class="modal-header">  
                    <div class="modal-pic"><icon class="icon icon-xl icon-warn-l"></icon></div>      
			    </div>
			    <div class="modal-body">
                    <div class="modal-message-tit text-center"></div>
                    <div class="check-method">
                        
                    </div>
			    </div>
			    <div class="modal-footer text-center">
				    <button type="button" class="btn btn-md btn-primary" data-toggle="close-modal">@LocalizerHelper.LocalizerResource["Common_MsgBoxButton_OK"]</button>
			    </div>
		    </div>
	    </div>
    </section>

    <section class="popover-error-message"></section>
    <div class="box device-error-panel-template hide" data-error-type="">
        <div class="box-header">
            <div class="box-header-left">
                <div class="box-header-title"><strong></strong></div>
            </div>
            <div class="box-header-right">
                <button class="btn btn-icon btn-default" data-toggle="close-box"><icon class="icon icon-close"></icon></button>
            </div>
        </div>
        <div class="box-body">
            <div class="box-body-left">
                <div class="system-check"></div>
            </div>
            <div class="box-body-right">
                <div class="error-info">
                    
                </div>
                <a class="view-check-method hide" href="javascript:void(0);">@LocalizerHelper.LocalizerResource["DeviceStatus_Error_Button_ViewCheckMethod"]</a>
                <div class="check-method">
                    
                </div>
            </div>
        </div>
    </div>

    <section class="modal modal-lg modal-message modal-message-alert" data-bind="animationIn:fadeInDown10,animationOut:fadeOutUp10">
	    <div class="modal-dialog">
		                
	    </div>
    </section>
    <div class="modal-content device-error-modal-template hide" data-error-type="">
		<div class="modal-header">  
            <div class="modal-pic"><icon class="icon icon-xl icon-warn-l"></icon></div>      
		</div>
		<div class="modal-body">
            <div class="modal-message-tit text-center"></div>
            <p class="no-check-method hide"></p>
            <div class="check-method">                
            </div>
		</div>
		<div class="modal-footer">
			<button type="button" class="btn btn-md btn-primary" data-toggle="check-complete">@LocalizerHelper.LocalizerResource["DeviceStatus_Error_Button_CheckComplete"]</button>
		</div>
	</div>

    <div class="simple-keyboard"></div>
    <input type="hidden" id="hidServerConfigConsts" value="@serverConfigConsts" />
</body>
</html>
