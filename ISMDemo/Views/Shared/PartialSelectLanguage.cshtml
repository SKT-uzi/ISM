@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@inject IOptions<RequestLocalizationOptions> LocOptions
@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var cultureItems = LocOptions.Value.SupportedUICultures
        .Select(c => new SelectListItem { Value = c.Name, Text = c.NativeName })
        .ToList();
    var returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/" : $"~{Context.Request.Path.Value}";
    var usCulture = System.Globalization.CultureInfo.GetCultureInfo("en-US");
}

<div class="popover popover-select-language">
    <form id="selectLanguage" asp-controller="Home" asp-action="SetLanguage" asp-route-returnUrl="@returnUrl"
        method="post" role="form">
        <div class="popover-mask"></div>
        <div class="popover-content">
            <div class="popover-body">
                <ul class="has-selected">
                    @foreach (SelectListItem item in cultureItems)
                    {
                        @if (requestCulture.RequestCulture.Culture.Name.ToLower() == item.Value.ToLower())
                        {
                            <li class="is-selected" data-target="@item.Value">
                                <icon class="icon icon-sm icon-checkmark"></icon>
                                <span>@usCulture.TextInfo.ToTitleCase(item.Text)</span>
                            </li>
                        }
                        else
                        {
                            <li data-target="@item.Value">
                                <icon class="icon icon-sm icon-checkmark"></icon>
                                <span>@usCulture.TextInfo.ToTitleCase(item.Text)</span>
                            </li>
                        }
                    }
                </ul>
            </div>
            <input type="hidden" id="hidSelectedCulture" name="culture" value="" />
        </div>
    </form>    
</div>